<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Smart Pantry Manager" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Reduce food waste using what you already have."
        android:layout_marginTop="12dp" android:gravity="center"/>
    <Button android:id="@+id/btnPantry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="My Pantry" android:layout_marginTop="30dp"/>
    <Button android:id="@+id/btnSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Suggested Recipes"/>
    <Button android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Settings"/>
</LinearLayout>
